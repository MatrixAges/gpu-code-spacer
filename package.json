{
  "name": "gpu-code-spacer",
  "version": "0.1.3",
  "description": "Model-based blank-line formatting, powered by Zig and WebAssembly.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatrixAges/gpu-code-spacer.git"
  },
  "homepage": "https://MatrixAges.github.io/gpu-code-spacer/",
  "keywords": [
    "formatter",
    "code",
    "spacing",
    "zig",
    "wasm"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/index.js",
      "default": "./dist/browser.js"
    },
    "./spacer.wasm": "./dist/spacer.wasm"
  },
  "scripts": {
    "build": "node tools/build-npm.mjs",
    "build:web": "npm run build && tsc --noEmit && vite build",
    "dev": "npm run build && vite",
    "preview": "vite preview",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "gpu-lexer": "^0.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
